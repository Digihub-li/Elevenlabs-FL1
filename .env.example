# Copy to .env and fill in. Never commit .env.

# Public IPv4 of this machine (the address FL1 and ElevenLabs must reach).
PUBLIC_IP=203.0.113.10

# Address Asterisk binds. On a VPS this is usually the same as PUBLIC_IP.
BIND_IP=203.0.113.10

# LAN or VPC range that must NOT appear in SDP.
LOCAL_NET=10.0.0.0/8

# FL1 CommPlus trunk. Username and password come from the trunk portal.
FL1_SIP_USER=your-trunk-username
FL1_SIP_PASSWORD=change-me
FL1_SIP_DOMAIN=t00000a.convoip.li
FL1_SIP_HOST=sbc6.ipbx.li
FL1_SIP_PORT=5083

# FL1 SBC address allowed to send calls to this bridge.
FL1_SBC_IP=80.66.238.49

# Main number, digits only, no plus. Used as outbound CLI and ElevenLabs dial target.
DID=42300000000
CLI_NAME=Example AG

# ElevenLabs SIP endpoint. The DID must already be imported on that agent.
ELEVENLABS_SIP_HOST=sip.rtc.elevenlabs.io
ELEVENLABS_SIP_PORT=5060

# Optional extra addresses that may send SIP toward the ElevenLabs endpoint.
# Space-separated. Leave empty if you only dial out to ElevenLabs.
ELEVENLABS_IDENTIFY_IPS=

TZ=Europe/Vaduz
USER_AGENT=EL-FL1-Bridge
